# ── Persistence (mirrors stock-service) ──
# false = JSON/cache only, no DB connection (app still loads)
PERSISTENCE_ENABLED=true

# Neon libpq URL (same project as stock-service, use -pooler hostname)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
#
# Or stock-service JDBC form (auto-converted):
# DB_URL="jdbc:postgresql://ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?user=USER&password=PASS&sslmode=require"
#
# DB_DRIVER=auto|http|pg  (auto = Neon HTTP over HTTPS, pg = TCP)
#
# Local dev fallback only (not used when DATABASE_URL points to Neon):
# USE_LOCAL_DB=1 ./start.sh dev

# ── Auth ──
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:4873"
PORT=4873

# ── AI (optional) ──
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
CRON_SECRET=""

# ── Vercel production ──
# Set these in Vercel → Project → Settings → Environment Variables:
#   DATABASE_URL      (Neon pooler URL, same as above)
#   AUTH_SECRET         (openssl rand -base64 32)
#   AUTH_URL            https://YOUR-PROJECT.vercel.app
#   PERSISTENCE_ENABLED true
#   DB_DRIVER           http
#   GROQ_API_KEY        (optional, for LLM answers)
#   CRON_SECRET         (optional, for scheduled /api/data/sync)
#
# Deploy: npx vercel login && npx vercel --prod
# On Vercel, trades/portfolio use Neon only (no local data/ JSON).

# ── Trading import (stock-service) ──
# STOCK_SERVICE_TRADES_FILE="../stock-service/cache/trading-records.json"
# STOCK_SERVICE_TRADES_USER="quocthien049"   # ledger key in stock-service JSON
# SYNC_TRADES_ON_READ=1   # optional: push JSON→Neon on each API read (off by default)
