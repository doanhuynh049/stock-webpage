# ── Persistence (mirrors stock-service) ──
# false = JSON/cache only, no DB connection (app still loads)
PERSISTENCE_ENABLED=true

# Neon libpq URL (same project as stock-service, use -pooler hostname)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
#
# Or stock-service JDBC form (auto-converted):
# DB_URL="jdbc:postgresql://ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?user=USER&password=PASS&sslmode=require"
#
# DB_DRIVER=auto|http|pg  (auto = Neon HTTP over HTTPS, pg = TCP)
#
# Local dev fallback only (not used when DATABASE_URL points to Neon):
# USE_LOCAL_DB=1 ./start.sh dev

# ── Auth ──
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:4962"
PORT=4962

# ── AI (optional) — configure any subset; unset ones are skipped in the fallback chain ──
# Settings → AI Providers lets each user reorder/enable providers and paste a personal key
# (overrides the env var below), plus a "Run test" button per provider.
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
SAMBANOVA_API_KEY=""
SAMBANOVA_MODEL="Meta-Llama-3.3-70B-Instruct"
COHERE_API_KEY=""
COHERE_MODEL="command-r-plus-08-2024"
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="meta-llama/Llama-3.3-70B-Instruct"
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_MODEL="@cf/meta/llama-3.1-8b-instruct"
# Ollama needs a reachable server — won't work from Vercel, local dev only.
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.2"
# LLM7 works anonymously with no key at all; setting one just raises its rate limit.
LLM7_API_KEY=""
LLM7_MODEL="gpt-4o-mini"
CRON_SECRET=""

# ── Vercel production ──
# Set these in Vercel → Project → Settings → Environment Variables:
#   DATABASE_URL      (Neon pooler URL, same as above)
#   AUTH_SECRET         (openssl rand -base64 32)
#   AUTH_URL            https://YOUR-PROJECT.vercel.app
#   PERSISTENCE_ENABLED true
#   DB_DRIVER           http
#   DB_CACHE_FIRST      0          ← required on Vercel (local JSON cache is not deployed)
#   GROQ_API_KEY        (optional, for LLM answers)
#   CRON_SECRET         (optional, for scheduled /api/data/sync)
#
# Deploy: npx vercel login && npx vercel --prod
# On Vercel, trades read Neon first; bundled data/user-trades/{userId}.json is read-only fallback.
# Set CACHE_USER_ID if prod login uuid differs from bundled JSON user id.

# ── Trading import (stock-service) ──
# STOCK_SERVICE_TRADES_FILE="../stock-service/cache/trading-records.json"
# STOCK_SERVICE_TRADES_USER="quocthien049"   # ledger key in stock-service JSON
# SYNC_TRADES_ON_READ=1   # optional: push JSON→Neon on each API read (off by default)
